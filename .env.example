# ==============================================================================
# TURSO & NETLIFY SERVERLESS BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Turso Cloud Database URL (Get from https://turso.tech dashboard or CLI: `turso db show <db-name> --url`)
# Example: libsql://portfolio-db-yourname.turso.io
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Turso Authentication Token (Get from Turso dashboard or CLI: `turso db tokens create <db-name>`)
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Admin Portal Credentials
ADMIN_EMAIL=admin@brian.dev
ADMIN_PASSWORD=your_secure_admin_password

# Secret used to sign authentication tokens
JWT_SECRET=your_random_secure_jwt_secret_string
